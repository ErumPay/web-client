VITE_APP_SERVICE=web-merchant
VITE_APP_TITLE=ErumPay 가맹점 관리자

# Browser API paths. Local development uses the Vite proxies below.
VITE_AUTH_API_BASE_URL=/backend/auth
VITE_MERCHANT_API_BASE_URL=/backend/merchant
VITE_AUTH_PROXY_TARGET=http://localhost:8091
VITE_MERCHANT_PROXY_TARGET=http://localhost:8094

# Kakao Developers REST API key and the registered redirect URI.
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/
